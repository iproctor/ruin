{
  "name": "@ruin/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs push"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.0.0",
    "@ruin/ai": "workspace:*",
    "@ruin/engine": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
